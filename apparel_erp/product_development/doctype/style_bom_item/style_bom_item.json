{
 "doctype": "DocType",
 "name": "Style BOM Item",
 "module": "Product Development",
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "fields": [
  {"fieldname": "item_type", "fieldtype": "Select", "label": "Item Type", "options": "Fabric\nTrim\nPackaging", "reqd": 1, "in_list_view": 1},
    {"fieldname": "item_name", "fieldtype": "Data", "label": "Item Name / Description", "in_list_view": 1},
    {"fieldname": "raw_material", "fieldtype": "Link", "label": "Selected Item", "options": "Item", "hidden": 1, "in_list_view": 0},
    {"fieldname": "new_item_code", "fieldtype": "Data", "label": "New Item Code", "in_list_view": 0},
  {"fieldname": "uom", "fieldtype": "Link", "label": "UOM", "options": "UOM", "reqd": 1, "in_list_view": 1},
  {"fieldname": "base_qty", "fieldtype": "Float", "label": "Base Qty", "reqd": 1, "in_list_view": 1, "precision": "3"},
  {"fieldname": "tolerance", "fieldtype": "Data", "label": "Tolerance", "in_list_view": 1},
  {"fieldname": "description", "fieldtype": "Data", "label": "Description", "description": "e.g. Cotton Poplin 120 GSM, 11 Lines Plastic Button"},
  {"fieldname": "composition", "fieldtype": "Data", "label": "Composition", "description": "e.g. 100% Cotton - fabric rows only"},
  {"fieldname": "gsm", "fieldtype": "Data", "label": "GSM", "description": "Fabric rows only"},
  {"fieldname": "consumption", "fieldtype": "Data", "label": "Consumption", "description": "Shown as-is on the Tech Pack, e.g. '1.65 m' or '7 Nos'"},
  {"fieldname": "available_in_market", "fieldtype": "Check", "label": "Available in Market", "default": 1, "in_list_view": 1, "description": "Uncheck if this material is not available in market"}
 ],
 "permissions": []
}
