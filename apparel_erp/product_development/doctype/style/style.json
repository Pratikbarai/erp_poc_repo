{
 "doctype": "DocType",
 "name": "Style",
 "module": "Product Development",
 "autoname": "field:style_no",
 "naming_rule": "By fieldname",
 "engine": "InnoDB",
 "is_submittable": 0,
 "image_field": "style_image",
 "title_field": "style_name",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {"fieldname": "tab_style_info", "fieldtype": "Tab Break", "label": "Style Information"},

  {"fieldname": "col_image", "fieldtype": "Column Break"},
  {"fieldname": "style_image", "fieldtype": "Attach Image", "label": "Style Image"},
  {"fieldname": "gallery_html", "fieldtype": "HTML", "description": "Click a thumbnail to set it as the main Style Image."},
  {"fieldname": "gallery", "fieldtype": "Table", "label": "Gallery", "options": "Style Gallery Image", "hidden": 1},

  {"fieldname": "col_left", "fieldtype": "Column Break"},
  {"fieldname": "style_no", "fieldtype": "Data", "label": "Style No", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "style_name", "fieldtype": "Data", "label": "Style Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "product_type", "fieldtype": "Select", "label": "Product Type", "options": "Shirt\nT-Shirt\nTrouser\nDress\nJacket\nSkirt"},
  {"fieldname": "category", "fieldtype": "Data", "label": "Category"},
  {"fieldname": "season", "fieldtype": "Data", "label": "Season"},
  {"fieldname": "launch_date", "fieldtype": "Date", "label": "Launch Date"},

  {"fieldname": "col_mid", "fieldtype": "Column Break"},
  {"fieldname": "customer_brand", "fieldtype": "Data", "label": "Customer / Brand"},
  {"fieldname": "designer", "fieldtype": "Data", "label": "Designer"},
  {"fieldname": "merchandiser", "fieldtype": "Data", "label": "Merchandiser"},
  {"fieldname": "department", "fieldtype": "Select", "label": "Department", "options": "Design\nMerchandising\nProduction\nSampling"},
  {"fieldname": "country_of_origin", "fieldtype": "Data", "label": "Country of Origin"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nActive\nOn Hold\nDiscontinued", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},

  {"fieldname": "col_desc", "fieldtype": "Column Break"},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Description"},
  {"fieldname": "sb_attrs", "fieldtype": "Section Break", "label": "Style Attributes"},
  {"fieldname": "col_attr1", "fieldtype": "Column Break"},
  {"fieldname": "fit", "fieldtype": "Data", "label": "Fit"},
  {"fieldname": "sleeve", "fieldtype": "Data", "label": "Sleeve"},
  {"fieldname": "placket", "fieldtype": "Data", "label": "Placket"},
  {"fieldname": "col_attr2", "fieldtype": "Column Break"},
  {"fieldname": "collar", "fieldtype": "Data", "label": "Collar"},
  {"fieldname": "gender", "fieldtype": "Select", "label": "Gender", "options": "Women\nMen\nUnisex\nKids"},
  {"fieldname": "fabric_type", "fieldtype": "Data", "label": "Fabric Type"},

  {"fieldname": "tab_colours_sizes", "fieldtype": "Tab Break", "label": "Colours & Sizes"},
  {"fieldname": "colours", "fieldtype": "Table", "label": "Colours", "options": "Style Colour"},
  {"fieldname": "sizes", "fieldtype": "Table MultiSelect", "label": "Sizes", "options": "Style Size", "description": "Select all sizes this style is offered in. The Colour \u00d7 Size matrix on the Matrix tab rebuilds automatically."},
  {"fieldname": "size_chart", "fieldtype": "Attach", "label": "Size Chart", "description": "PDF or image shown via the Size Chart button, here and on the Design & Tech Pack."},

  {"fieldname": "tab_bom", "fieldtype": "Tab Break", "label": "Style BOM (Base)"},
  {"fieldname": "bom_items", "fieldtype": "Table", "label": "BOM Items", "options": "Style BOM Item"},
  {"fieldname": "bom_note", "fieldtype": "Small Text", "label": "Note", "read_only": 1, "default": "Quantities are for size 'M' and base colour. Size/Colour wise consumption can be managed in exceptions."},

  {"fieldname": "tab_matrix", "fieldtype": "Tab Break", "label": "Matrix"},
  {"fieldname": "matrix_html", "fieldtype": "HTML", "label": "Colour - Size Matrix (Auto Generated SKUs)"},
  {"fieldname": "matrix_items", "fieldtype": "Table", "label": "Matrix Items (Generated)", "options": "Style Matrix Item", "read_only": 1, "hidden": 1},

  {"fieldname": "tab_workflow", "fieldtype": "Tab Break", "label": "Development Workflow"},
  {"fieldname": "development_stage", "fieldtype": "Select", "label": "Development Stage",
   "options": "Style Created\nDesign & Tech Pack\nSampling\nFit Approval\nProto Approval\nProduction",
   "default": "Style Created", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "workflow_html", "fieldtype": "HTML"},

  {"fieldname": "tab_rest_api", "fieldtype": "Tab Break", "label": "REST API"},
  {"fieldname": "rest_api_html", "fieldtype": "HTML", "label": "REST API"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0},
  {"role": "Manufacturing Manager", "read": 1, "write": 1, "create": 1}
 ]
}
