    {
      "fieldname": "gender",
      "fieldtype": "Select",
      "label": "Gender",
      "options": "Women\nMen\nUnisex\nKids"
    },
    {
      "fieldname": "fabric_type",
      "fieldtype": "Data",
      "label": "Fabric Type"
    },
    {
      "fieldname": "colours",
      "fieldtype": "Table",
      "label": "Colours",
      "options": "Style Colour"
    },
    {
      "fieldname": "sizes",
      "fieldtype": "Table MultiSelect",
      "label": "Sizes",
