    },
    {
      "fieldname": "size_chart",
      "fieldtype": "Attach",
      "label": "Size Chart",
      "description": "PDF or image shown via the Size Chart button, here and on the Design & Tech Pack."
    },
    {
      "fieldname": "bom_items",
      "fieldtype": "Table",
      "label": "BOM Items",
      "options": "Style BOM Item"
    },
    {
      "fieldname": "bom_note",
      "fieldtype": "Small Text",
      "label": "Note",
      "read_only": 1,
      "default": "Quantities are for size 'M' and base colour. Size/Colour wise consumption can be managed in exceptions."
    },
    {
      "fieldname": "bom_version",
      "fieldtype": "Data",
      "label": "BOM Version",
      "default": "1.0",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "matrix_html",
      "fieldtype": "HTML",
      "label": "Colour - Size Matrix (Auto Generated SKUs)"
    },
    {
      "fieldname": "matrix_items",
      "fieldtype": "Table",
      "label": "Matrix Items (Generated)",
      "options": "Style Matrix Item",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "development_stage",
      "fieldtype": "Select",
      "label": "Development Stage",
      "options": "Style Created\nDesign & Tech Pack\nSampling\nFit Approval\nProto Approval\nProduction",
      "default": "Style Created",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "workflow_html",
      "fieldtype": "HTML"
    }
