      "label": "Product Type",
      "options": "Shirt\nT-Shirt\nTrouser\nDress\nJacket\nSkirt"
    },
    {
      "fieldname": "category",
      "fieldtype": "Data",
      "label": "Category"
    },
    {
      "fieldname": "season",
