  "modules": [],
  "is_submittable": 0,
  "autoname": "field:style_no",
  "naming_rule": "By fieldname",
  "engine": "InnoDB",
  "sort_field": "modified",
  "sort_order": "DESC",
  "image_field": "style_image",
  "title_field": "style_name",
  "track_changes": 1,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0
    },
    {
      "role": "Manufacturing Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
